@model List<PetClinicApp.Core.Models.Appointment>
@using PetClinicApp.Core.Models
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📅 Appointments</h2>
    <a asp-action="Create" class="btn btn-warning">+ New Appointment</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No appointments found.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Date & Time</th>
                <th>Pet</th>
                <th>Type</th>
                <th>Status</th>
                <th>Fee</th>
                <th>Paid</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.OrderByDescending(x => x.AppointmentDate))
            {
                <tr>
                    <td>@a.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@a.Pet?.Name</td>
                    <td>
                        @if (a.Type == AppointmentType.Veterinary)
                        {
                            <span class="badge bg-danger">🩺 Veterinary</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">✂️ Grooming</span>
                        }
                    </td>
                    <td>
                        @if (a.Status == AppointmentStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">⏳ Pending</span>
                        }
                        else if (a.Status == AppointmentStatus.Completed)
                        {
                            <span class="badge bg-success">✅ Completed</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">❌ Cancelled</span>
                        }
                    </td>
                    <td>@a.ServiceFee.ToString("C2")</td>
                    <td>@(a.IsPaid ? "✅" : "❌")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-danger"
                           onclick="return confirm('Delete this appointment?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
