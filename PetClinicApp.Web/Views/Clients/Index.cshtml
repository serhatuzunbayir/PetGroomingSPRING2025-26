@model List<PetClinicApp.Core.Models.Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>👤 Clients</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Client</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form method="get" class="d-flex mb-3">
    <input name="search" value="@ViewBag.Search" class="form-control me-2" placeholder="Search by name..." />
    <button type="submit" class="btn btn-outline-secondary">Search</button>
    @if (!string.IsNullOrEmpty(ViewBag.Search as string))
    {
        <a asp-action="Index" class="btn btn-outline-danger ms-1">Clear</a>
    }
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No clients found.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Pets</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.FirstName @client.LastName</td>
                    <td>@client.PhoneNumber</td>
                    <td>@client.Email</td>
                    <td><span class="badge bg-secondary">@client.Pets.Count pet(s)</span></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-danger"
                           onclick="return confirm('Delete @client.FirstName @client.LastName?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
