@model List<PetClinicApp.Core.Models.Pet>
@{
    ViewData["Title"] = "Pets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🐾 Pets</h2>
    <a asp-action="Create" class="btn btn-success">+ Add Pet</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No pets registered yet.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Species</th>
                <th>Age</th>
                <th>Gender</th>
                <th>Owner</th>
                <th>Clinical Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pet in Model)
            {
                <tr>
                    <td><strong>@pet.Name</strong></td>
                    <td>@pet.Species</td>
                    <td>@pet.Age yr</td>
                    <td>@pet.Gender</td>
                    <td>@pet.Client?.FirstName @pet.Client?.LastName</td>
                    <td>
                        @if (!string.IsNullOrEmpty(pet.ClinicalNotes))
                        {
                            <span title="@pet.ClinicalNotes">📋 @(pet.ClinicalNotes.Length > 30 ? pet.ClinicalNotes[..30] + "…" : pet.ClinicalNotes)</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@pet.Id" class="btn btn-sm btn-danger"
                           onclick="return confirm('Delete @pet.Name?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
