@model PetClinicApp.Core.Models.Pet
@{
    ViewData["Title"] = "Add Pet";
    var clients = ViewBag.Clients as List<PetClinicApp.Core.Models.Client> ?? new();
}

<h2>🐾 Add New Pet</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Species" class="form-label"></label>
                <input asp-for="Species" class="form-control" placeholder="e.g. Dog, Cat, Bird" />
            </div>
            <div class="mb-3">
                <label asp-for="Age" class="form-label"></label>
                <input asp-for="Age" class="form-control" type="number" min="0" />
            </div>
            <div class="mb-3">
                <label asp-for="Gender" class="form-label"></label>
                <select asp-for="Gender" class="form-select">
                    <option value="">-- Select --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="ClientId" class="form-label">Owner</label>
                <select asp-for="ClientId" class="form-select" required>
                    <option value="">-- Select Owner --</option>
                    @foreach (var c in clients)
                    {
                        <option value="@c.Id">@c.FirstName @c.LastName</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="ClinicalNotes" class="form-label"></label>
                <textarea asp-for="ClinicalNotes" class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-success">Save</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
