@{
    ViewData["Title"] = "Home";
}

<!-- Ana sayfa: Klinik web portalı karşılama sayfası -->
<div class="text-center py-4">
    <h1 class="display-5 fw-bold" style="color: #2A9D8F;">🐾 Pet Grooming & Veterinary Clinic</h1>
    <p class="lead text-muted">Welcome to the online customer portal. Book appointments, view your pet's records and appointment history.</p>
    <hr class="my-4" />
</div>

<!-- Hızlı erişim kartları -->
<div class="row g-4 mb-5">

    <!-- Randevu Al -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0" style="border-top: 4px solid #2A9D8F !important;">
            <div class="card-body text-center p-4">
                <div style="font-size: 3rem;">📅</div>
                <h5 class="card-title fw-bold mt-2">Book Appointment</h5>
                <p class="card-text text-muted">Schedule a veterinary or grooming appointment for your pet.</p>
                <a asp-controller="Appointment" asp-action="Book"
                   class="btn btn-success" id="btn-book-appointment">
                    Book Now
                </a>
            </div>
        </div>
    </div>

    <!-- Randevularım -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0" style="border-top: 4px solid #E9C46A !important;">
            <div class="card-body text-center p-4">
                <div style="font-size: 3rem;">📋</div>
                <h5 class="card-title fw-bold mt-2">My Appointments</h5>
                <p class="card-text text-muted">View your past and upcoming appointments, filtered by your name.</p>
                <a asp-controller="Appointment" asp-action="MyAppointments"
                   class="btn btn-warning" id="btn-my-appointments">
                    View Mine
                </a>
            </div>
        </div>
    </div>

    <!-- Hayvanlarım -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0" style="border-top: 4px solid #264653 !important;">
            <div class="card-body text-center p-4">
                <div style="font-size: 3rem;">🐕</div>
                <h5 class="card-title fw-bold mt-2">Pet Profiles</h5>
                <p class="card-text text-muted">Browse all registered pets and view their clinical notes and history.</p>
                <a asp-controller="Pet" asp-action="Index"
                   class="btn btn-dark" id="btn-view-pets">
                    View Pets
                </a>
            </div>
        </div>
    </div>

</div>

<!-- Hakkımızda bilgi -->
<div class="card border-0 bg-light p-4">
    <h4 class="fw-bold mb-3" style="color: #264653;">ℹ️ About This Portal</h4>
    <div class="row">
        <div class="col-md-6">
            <ul class="list-unstyled">
                <li>✅ <strong>Online Appointment Booking</strong> — Veterinary or Grooming</li>
                <li>✅ <strong>Appointment History</strong> — View past & upcoming visits</li>
                <li>✅ <strong>Pet Profiles</strong> — Clinical notes & records</li>
            </ul>
        </div>
        <div class="col-md-6">
            <ul class="list-unstyled">
                <li>📧 For staff management, use the <strong>Desktop Application</strong></li>
                <li>⚡ Real-time notifications when appointments are booked</li>
                <li>🔒 Your data is only visible to you and clinic staff</li>
            </ul>
        </div>
    </div>
</div>
