@using PetClinicApp.Core.Models
@{
    ViewData["Title"] = "Dashboard";
    var appointments = ViewBag.TodaysAppointments as List<Appointment> ?? new();
    var summary = ViewBag.Summary as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🏥 Pet Clinic Dashboard</h2>
    <small class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</small>
</div>

<div class="alert alert-info">
    <strong>📊 Clinic Summary:</strong> @summary
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body text-center">
                <h5 class="card-title">👤 Clients</h5>
                <a href="/Clients" class="btn btn-light btn-sm mt-1">Manage Clients</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-body text-center">
                <h5 class="card-title">🐾 Pets</h5>
                <a href="/Pets" class="btn btn-light btn-sm mt-1">Manage Pets</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body text-center">
                <h5 class="card-title">📅 Appointments</h5>
                <a href="/Appointments" class="btn btn-light btn-sm mt-1">Manage Appointments</a>
            </div>
        </div>
    </div>
</div>

<h4>📋 Today's Appointments</h4>
@if (!appointments.Any())
{
    <div class="alert alert-secondary">No appointments scheduled for today.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Time</th>
                <th>Pet</th>
                <th>Owner</th>
                <th>Type</th>
                <th>Status</th>
                <th>Fee</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in appointments)
            {
                <tr>
                    <td>@a.AppointmentDate.ToString("HH:mm")</td>
                    <td>@a.Pet?.Name</td>
                    <td>@a.Pet?.Client?.FirstName @a.Pet?.Client?.LastName</td>
                    <td>
                        @if (a.Type == AppointmentType.Veterinary)
                        {
                            <span class="badge bg-danger">🩺 Veterinary</span>
                        }
                        else
                        {
                            <span class="badge bg-info">✂️ Grooming</span>
                        }
                    </td>
                    <td>
                        @if (a.Status == AppointmentStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else if (a.Status == AppointmentStatus.Completed)
                        {
                            <span class="badge bg-success">Completed</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Cancelled</span>
                        }
                    </td>
                    <td>@a.ServiceFee.ToString("C2")</td>
                </tr>
            }
        </tbody>
    </table>
}
