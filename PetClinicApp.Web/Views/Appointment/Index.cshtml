@model List<PetClinicApp.Core.Models.Appointment>
@{
    ViewData["Title"] = "All Appointments";
}

<!-- Sayfa başlığı ve özet istatistikler -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1 fw-bold" style="color: #2A9D8F;">🗓️ Appointment Calendar</h2>
        <p class="text-muted mb-0">Overview of all clinic appointments.</p>
    </div>
    <a asp-action="Book" class="btn btn-success" id="btn-new-appointment">📅 Book New</a>
</div>

<!-- İstatistik kartları -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm" style="border-left: 4px solid #2A9D8F !important;">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold" style="color: #2A9D8F;">@ViewBag.TodayCount</div>
                <div class="text-muted small">Today's Appointments</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-dark">@ViewBag.TotalCount</div>
                <div class="text-muted small">Total Appointments</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-warning">
                    @(Model.Count(a => a.Status == PetClinicApp.Core.Models.AppointmentStatus.Pending))
                </div>
                <div class="text-muted small">Pending</div>
            </div>
        </div>
    </div>
</div>

<!-- Randevu listesi tablosu -->
@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        No appointments yet. <a asp-action="Book">Book the first one →</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="all-appointments-table">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Pet</th>
                    <th>Type</th>
                    <th>Date & Time</th>
                    <th>Status</th>
                    <th>Fee</th>
                    <th>Paid</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model.OrderByDescending(a => a.AppointmentDate))
                {
                    <tr>
                        <td class="text-muted">@appt.Id</td>
                        <td class="fw-semibold">🐾 @(appt.Pet?.Name ?? "Unknown")</td>
                        <td>
                            @if (appt.Type == PetClinicApp.Core.Models.AppointmentType.Veterinary)
                            {
                                <span class="badge bg-danger">🏥 Veterinary</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">✂️ Grooming</span>
                            }
                        </td>
                        <td>@appt.AppointmentDate.ToString("dd MMM yyyy, HH:mm")</td>
                        <td>
                            @switch (appt.Status)
                            {
                                case PetClinicApp.Core.Models.AppointmentStatus.Pending:
                                    <span class="badge bg-warning text-dark">⏳ Pending</span>
                                    break;
                                case PetClinicApp.Core.Models.AppointmentStatus.Completed:
                                    <span class="badge bg-success">✅ Completed</span>
                                    break;
                                case PetClinicApp.Core.Models.AppointmentStatus.Cancelled:
                                    <span class="badge bg-secondary">❌ Cancelled</span>
                                    break;
                            }
                        </td>
                        <td>@appt.ServiceFee.ToString("C2")</td>
                        <td>@(appt.IsPaid ? "✅" : "❌")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
