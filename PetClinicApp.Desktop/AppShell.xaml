<?xml version="1.0" encoding="UTF-8" ?>
<!--
    AppShell: Uygulamanın ana navigasyon çerçevesi.
    TabBar içindeki her ShellContent bir sekme (tab) sayfasını temsil eder.
    Sekmeler: Dashboard, Clients (Müşteriler), Pets (Hayvanlar), Appointments (Randevular)
-->
<Shell
    x:Class="PetClinicApp.Desktop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PetClinicApp.Desktop"
    Title="PetClinicApp">

    <TabBar>
        <!-- Dashboard: Klinik özet istatistikleri ve hızlı erişim -->
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <!-- Clients: Müşteri kayıtları CRUD işlemleri -->
        <ShellContent
            Title="Clients"
            ContentTemplate="{DataTemplate local:ClientsPage}"
            Route="ClientsPage" />

        <!-- Pets: Evcil hayvan kayıtları CRUD işlemleri -->
        <ShellContent
            Title="Pets"
            ContentTemplate="{DataTemplate local:PetsPage}"
            Route="PetsPage" />

        <!-- Appointments: Randevu yönetimi, filtreleme ve delegate bildirimleri -->
        <ShellContent
            Title="Appointments"
            ContentTemplate="{DataTemplate local:AppointmentsPage}"
            Route="AppointmentsPage" />
    </TabBar>

</Shell>

